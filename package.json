{
  "name": "@sandsoftwaresolutions/walk-files",
  "version": "0.1.1",
  "description": "Walk a folder in a stable order with .gitignore-style rules, never following symlinks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "walk",
    "glob",
    "gitignore",
    "filesystem"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-walk-files.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-walk-files/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-walk-files#readme",
  "publishConfig": {
    "access": "public"
  }
}
